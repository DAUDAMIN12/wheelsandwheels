MONGODB_URI=mongodb://127.0.0.1:27017/wheels-and-wheels
PORT=5000
CLIENT_URL=http://localhost:5173
VITE_SITE_URL=https://your-domain.example
CATALOG_CACHE_TTL_MS=300000
MONGO_POOL_SIZE=10
MONGO_MAX_CONNECTING=2
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@wheelsandwheels.pk
ADMIN_PASSWORD=change-this-password
NOTIFICATION_EMAIL=wheelsandwheelsinfo@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=wheelsandwheelsinfo@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
